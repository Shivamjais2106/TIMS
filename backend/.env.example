# ---------------------------------------------------------------------------
# TIMS Backend — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The database must have the PostGIS extension
# available (the initial migration runs `CREATE EXTENSION IF NOT EXISTS postgis`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tims?schema=public"

# Secret used to sign JWT access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma separated list of browser origins allowed to call this API.
FRONTEND_URL="http://localhost:3000"

# HTTP server
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# NASA FIRMS (optional — leave blank during development)
# Request a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
# When FIRMS_MAP_KEY is empty the backend transparently uses the mock provider
# and the rest of the application keeps working.
# ---------------------------------------------------------------------------
FIRMS_MAP_KEY=""
FIRMS_BASE_URL="https://firms.modaps.eosdis.nasa.gov/api"
FIRMS_SOURCE="VIIRS_SNPP_NRT"
# Area of interest as "minLon,minLat,maxLon,maxLat". Default is the India bbox.
FIRMS_AREA="68.0,6.0,98.0,38.0"
FIRMS_DAY_RANGE=1

# ---------------------------------------------------------------------------
# OpenStreetMap / Overpass (optional)
# ---------------------------------------------------------------------------
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSM_ENABLED=false

# ---------------------------------------------------------------------------
# Scheduled jobs (node-cron). Disable while developing to keep logs quiet.
# ---------------------------------------------------------------------------
ENABLE_CRON_JOBS=false
FIRMS_CRON_SCHEDULE="*/30 * * * *"
OSM_CRON_SCHEDULE="0 3 * * 0"
ANALYTICS_CRON_SCHEDULE="15 * * * *"
