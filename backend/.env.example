# ---------------------------------------------------------------------------
# TIMS Backend — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. The database must have the PostGIS extension
# available (the initial migration runs `CREATE EXTENSION IF NOT EXISTS postgis`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tims?schema=public"

# Secret used to sign JWT access tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Comma separated list of browser origins allowed to call this API.
FRONTEND_URL="http://localhost:3000"

# HTTP server
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# NASA FIRMS — PRIMARY THERMAL DATA SOURCE
# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
#
# Verified against the live API on 2026-09-15:
#   * dayRange is limited to 1..5 (larger values return HTTP 400)
#   * the Bhopal pilot bbox has 0 NRT detections in September (monsoon), so the
#     ingest falls back to the FIRMS *archive* fire season and logs which window
#     it used. It never substitutes synthetic data.
# ---------------------------------------------------------------------------
FIRMS_MAP_KEY=""
FIRMS_BASE_URL="https://firms.modaps.eosdis.nasa.gov/api"
# Leave FIRMS_AREA blank to use BHOPAL_BBOX from shared/bhopal.config.json.
FIRMS_AREA=""
FIRMS_DAY_RANGE=5
FIRMS_MIN_LIVE_RECORDS=1
FIRMS_ARCHIVE_FALLBACK=true

# ---------------------------------------------------------------------------
# OpenStreetMap / Overpass — industrial + emergency facility geometry
# Overpass returns HTTP 406 to clients that do not identify themselves.
# ---------------------------------------------------------------------------
OSM_OVERPASS_URL="https://overpass-api.de/api/interpreter"
OSM_ENABLED=true
OSM_USER_AGENT="TIMS-SIH26162/1.0 (thermal monitoring research)"

# ---------------------------------------------------------------------------
# ML classification service (ml-service/, FastAPI + XGBoost)
# When unreachable the backend falls back to a rule-based baseline and records
# classificationPath=RULE_FALLBACK on the hotspot, so the UI never implies a
# model prediction that did not happen.
# ---------------------------------------------------------------------------
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_ENABLED=true
ML_SERVICE_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Weather context — IMD first, Open-Meteo as a clearly-labelled fallback.
# IMD publishes no documented public API; leave blank and the UI shows
# "Weather data unavailable" rather than inventing an observation.
# ---------------------------------------------------------------------------
IMD_API_KEY=""
IMD_BASE_URL=""
WEATHER_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# ISRO / NRSC Bhuvan — requires registration and often IP whitelisting.
# The application works fully without these.
# ---------------------------------------------------------------------------
BHUVAN_API_KEY=""
BHUVAN_BASE_URL=""

# ---------------------------------------------------------------------------
# DEMO_MODE is explicit opt-in only and is never an automatic fallback.
# ---------------------------------------------------------------------------
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Scheduled jobs (node-cron)
# ---------------------------------------------------------------------------
ENABLE_CRON_JOBS=false
FIRMS_CRON_SCHEDULE="*/30 * * * *"
OSM_CRON_SCHEDULE="0 3 * * 0"
ANALYTICS_CRON_SCHEDULE="15 * * * *"
WEATHER_CRON_SCHEDULE="*/30 * * * *"
RISK_CRON_SCHEDULE="10,40 * * * *"
